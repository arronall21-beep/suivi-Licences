# ============================================================================
# SBEE — Gestion du Patrimoine SI — configuration PRODUCTION (modèle)
# Copier en `.env` (chmod 600) et remplacer TOUTES les valeurs <A_DEFINIR>.
# Ne jamais committer le fichier .env. Vérifier avec : ./scripts/preflight.sh
# ============================================================================

# Fichiers Compose utilisés par toutes les commandes `docker compose` du dossier
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Base de données ---
POSTGRES_DB=suivi_licences
POSTGRES_USER=suivi
POSTGRES_PASSWORD=<A_DEFINIR>

# --- Sécurité ---
ENVIRONMENT=production
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<A_DEFINIR>
# Vide = dérivée de SECRET_KEY. Si elle change, le mot de passe SMTP enregistré est à ressaisir.
# À sauvegarder séparément (sans elle, les secrets chiffrés en base sont irrécupérables).
SETTINGS_ENCRYPTION_KEY=<A_DEFINIR>
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Compte administrateur initial (créé seulement s'il n'existe pas) ---
# Mot de passe : 8 caractères minimum, une lettre et un chiffre — viser 16+.
ADMIN_EMAIL=<A_DEFINIR>
ADMIN_PASSWORD=<A_DEFINIR>
# Pas de comptes de démonstration en production : valeurs vides = comptes non créés.
MANAGER_EMAIL=
MANAGER_PASSWORD=
VIEWER_EMAIL=
VIEWER_PASSWORD=

# --- Paramètres généraux de départ (modifiables ensuite dans Administration → Paramètres) ---
ORGANIZATION_NAME=SBEE
APPLICATION_NAME=Gestion du Patrimoine SI
CURRENCY=XOF
DEFAULT_TIMEZONE=Africa/Porto-Novo
CRITICAL_DAYS=30
ALERT_DAYS=90

# --- Accès ---
# URL publique exacte de l'application, telle que saisie dans le navigateur (schéma + hôte + port éventuel).
CORS_ORIGINS=<A_DEFINIR ex. http://si.sbee.local>
MAX_UPLOAD_MB=10
# Port publié par le frontend (nginx). 80 en HTTP simple ; voir docs/DEPLOY.md pour HTTPS.
FRONTEND_PORT=80
# Interface d'écoute : 0.0.0.0 (réseau) ou 127.0.0.1 si un reverse proxy TLS est placé devant.
FRONTEND_BIND=0.0.0.0

# --- Alertes email (repli ; la config Administration → SMTP en base est prioritaire) ---
SCHEDULER_ENABLED=true
ALERT_HOUR=7
ALERT_THRESHOLDS=90,60,30,7
ALERT_RECIPIENTS=

# --- Sauvegardes ---
BACKUP_DIR=/backups
BACKUP_KEEP_DAYS=14

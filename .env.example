# --- Base de données ---
POSTGRES_DB=suivi_licences
POSTGRES_USER=suivi
POSTGRES_PASSWORD=change-me

# --- Sécurité (générer une clé : python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=production

# Clé de chiffrement des secrets stockés en base (mot de passe SMTP). Vide = dérivée de SECRET_KEY.
# Si elle change, les secrets enregistrés sont à ressaisir. Ne jamais la committer.
SETTINGS_ENCRYPTION_KEY=

# Comptes créés au premier démarrage s'ils n'existent pas (À CHANGER, puis gérer depuis Administration → Utilisateurs)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=manager123
VIEWER_EMAIL=viewer@example.com
VIEWER_PASSWORD=viewer123

# Valeurs par défaut des paramètres généraux (modifiables ensuite dans Administration → Paramètres)
ORGANIZATION_NAME=SBEE
APPLICATION_NAME=Gestion du Patrimoine SI
CURRENCY=XOF
DEFAULT_TIMEZONE=Africa/Porto-Novo
CRITICAL_DAYS=30
ALERT_DAYS=90

# Origines autorisées (développement Vite + frontend Docker)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=10

# --- Alertes email (job quotidien) ---
# Valeurs de repli : la configuration saisie dans Administration → SMTP (stockée en base, mot de passe chiffré) est prioritaire.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_SECURITY=
ALERT_RECIPIENTS=
ALERT_THRESHOLDS=90,60,30,7
ALERT_HOUR=7
SCHEDULER_ENABLED=true

# --- Sauvegardes (répertoire lu par Administration → Système) ---
BACKUP_DIR=/backups

# --- Ports exposés ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
ADMINER_PORT=8081

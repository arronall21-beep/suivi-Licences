# --- Base de données ---
POSTGRES_DB=suivi_licences
POSTGRES_USER=suivi
POSTGRES_PASSWORD=change-me

# --- Sécurité (générer une clé : python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ENVIRONMENT=production

# Comptes créés au premier démarrage s'ils n'existent pas
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
VIEWER_EMAIL=viewer@example.com
VIEWER_PASSWORD=viewer123

# Origines autorisées (développement Vite + frontend Docker)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=10
CURRENCY=XOF
CURRENCY_LABEL=FCFA

# --- Alertes email (job quotidien) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
ALERT_RECIPIENTS=dsi@example.com,achats@example.com
ALERT_THRESHOLDS=90,60,30,7
ALERT_HOUR=7
SCHEDULER_ENABLED=true

# --- Ports exposés ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
ADMINER_PORT=8081
